<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioMenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root"
            xmlns="http://javafx.com/javafx/24"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ui.InterfazPrincipalController"
            styleClass="ide-root">

    <!-- BARRA SUPERIOR -->
    <top>
        <VBox>
            <MenuBar styleClass="ide-menu-bar">
                <Menu text="Archivo">
                    <MenuItem text="Nuevo" fx:id="itemArchivoNuevo" accelerator="Shortcut+N"/>
                    <MenuItem text="Abrir" fx:id="itemArchivoAbrir" accelerator="Shortcut+O"/>
                    <MenuItem text="Abrir proyecto..." fx:id="itemArchivoAbrirProyecto" accelerator="Shortcut+Shift+O"/>
                    <MenuItem text="Guardar" fx:id="itemArchivoGuardar" accelerator="Shortcut+S"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Salir" fx:id="itemOpcionesSalir"/>
                </Menu>
                <Menu text="Editar">
                    <MenuItem text="Cortar" fx:id="itemEditarCortar"/>
                    <MenuItem text="Copiar" fx:id="itemEditarCopiar"/>
                    <MenuItem text="Pegar" fx:id="itemEditarPegar"/>
                </Menu>
                <Menu text="Opciones">
                    <RadioMenuItem text="Modo Claro" fx:id="radioModoClaro"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Configurar API de CerberusAI..." fx:id="itemConfigurarApiIA"/>
                </Menu>
            </MenuBar>

            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="ide-toolbar">
                <padding>
                    <Insets top="8" right="16" bottom="8" left="14"/>
                </padding>

                <ImageView fitHeight="26" preserveRatio="true" smooth="true">
                    <Image url="@../Imagenes/logoCT.png"/>
                </ImageView>
                <Label text="CERBERUS" styleClass="ide-brand"/>
                <Label text="IDE" styleClass="ide-brand-secondary"/>

                <Label text="/" styleClass="toolbar-slash"/>
                <Label fx:id="lblProyecto" text="Sin proyecto" styleClass="toolbar-project"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="▶  Compilar" fx:id="btnCompilar" styleClass="btn-compilar"/>
                <Button text="⏵  Ejecutar" fx:id="btnEjecutar" styleClass="btn-ghost"/>
            </HBox>
        </VBox>
    </top>

    <!-- ÁREA PRINCIPAL DEL IDE -->
    <center>
        <SplitPane fx:id="splitPrincipal"
                   dividerPositions="0.19, 0.77"
                   styleClass="ide-split">
            <items>

                <!-- EXPLORADOR -->
                <VBox spacing="8" styleClass="card">
                    <padding>
                        <Insets top="12" right="10" bottom="10" left="10"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="EXPLORADOR" styleClass="panel-heading"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="↻" fx:id="btnRefrescarProyecto" styleClass="icon-button"/>
                    </HBox>

                    <Button text="Abrir carpeta" fx:id="btnAbrirProyecto"
                            maxWidth="Infinity" styleClass="btn-ghost"/>

                    <Label fx:id="lblProyectoVacio"
                           text="No hay ningún proyecto abierto. Usa «Abrir carpeta» para empezar."
                           wrapText="true"
                           styleClass="texto-tenue"/>

                    <TreeView fx:id="treeProyecto"
                              visible="false"
                              managed="false"
                              VBox.vgrow="ALWAYS"
                              styleClass="project-tree"/>
                </VBox>

                <!-- EDITOR Y RESULTADOS -->
                <SplitPane orientation="VERTICAL"
                           dividerPositions="0.68"
                           styleClass="ide-split-interno">
                    <items>
                        <VBox styleClass="card">
                            <TabPane fx:id="tabsEditor"
                                     VBox.vgrow="ALWAYS"
                                     tabClosingPolicy="ALL_TABS"
                                     styleClass="editor-tabs-pane"/>
                        </VBox>

                        <VBox styleClass="card">
                            <TabPane fx:id="tabResultados"
                                     tabClosingPolicy="UNAVAILABLE"
                                     VBox.vgrow="ALWAYS"
                                     styleClass="resultados-pane">
                                <tabs>
                                    <Tab text="Léxico">
                                        <content>
                                            <TextArea fx:id="txtLexico" editable="false" styleClass="resultado"/>
                                        </content>
                                    </Tab>
                                    <Tab text="Sintáctico">
                                        <content>
                                            <TextArea fx:id="txtSintactico" editable="false" styleClass="resultado"/>
                                        </content>
                                    </Tab>
                                    <Tab text="Semántico">
                                        <content>
                                            <TextArea fx:id="txtSemantico" editable="false" styleClass="resultado"/>
                                        </content>
                                    </Tab>
                                    <Tab text="Documentador">
                                        <content>
                                            <TextArea fx:id="txtDocumentador" editable="false" styleClass="resultado"/>
                                        </content>
                                    </Tab>
                                    <Tab text="Consola" fx:id="tabConsola">
                                        <content>
                                            <TextArea fx:id="txtConsola" editable="false" styleClass="resultado"/>
                                        </content>
                                    </Tab>
                                </tabs>
                            </TabPane>
                        </VBox>
                    </items>
                </SplitPane>

                <!-- PANEL CERBERUSAI -->
                <VBox styleClass="card">
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="ai-header">
                        <padding>
                            <Insets top="12" right="12" bottom="10" left="12"/>
                        </padding>
                        <ImageView fitHeight="30" preserveRatio="true" smooth="true">
                            <Image url="@../Imagenes/logoCT.png"/>
                        </ImageView>
                        <VBox spacing="1">
                            <Label text="CERBERUSai" styleClass="ai-title"/>
                            <Label text="Asistente de programación" styleClass="texto-tenue"/>
                        </VBox>
                    </HBox>

                    <fx:include source="chat_cerberus.fxml"
                                fx:id="chatCerberus"
                                VBox.vgrow="ALWAYS"/>
                </VBox>

            </items>
        </SplitPane>
    </center>

    <!-- BARRA DE ESTADO -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="ide-status-bar">
            <padding>
                <Insets top="4" right="14" bottom="4" left="14"/>
            </padding>
            <Label fx:id="lblEstado" text="Listo" styleClass="estado"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblPosicion" text="Línea 1, columna 1" styleClass="status-item"/>
            <Label text="UTF-8" styleClass="status-item"/>
        </HBox>
    </bottom>

</BorderPane>
