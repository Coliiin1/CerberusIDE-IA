<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioMenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root"
            xmlns="http://javafx.com/javafx/24"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ui.InterfazPrincipalController"
            styleClass="ide-root">

    <!-- BARRA SUPERIOR -->
    <top>
        <VBox spacing="0">
            <MenuBar styleClass="ide-menu-bar">
                <Menu text="Archivo">
                    <MenuItem text="Nuevo" fx:id="itemArchivoNuevo" accelerator="Shortcut+N"/>
                    <MenuItem text="Abrir" fx:id="itemArchivoAbrir" accelerator="Shortcut+O"/>
                    <MenuItem text="Abrir proyecto..." fx:id="itemArchivoAbrirProyecto" accelerator="Shortcut+Shift+O"/>
                    <MenuItem text="Guardar" fx:id="itemArchivoGuardar" accelerator="Shortcut+S"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Salir" fx:id="itemOpcionesSalir"/>
                </Menu>
                <Menu text="Editar">
                    <MenuItem text="Cortar" fx:id="itemEditarCortar"/>
                    <MenuItem text="Copiar" fx:id="itemEditarCopiar"/>
                    <MenuItem text="Pegar" fx:id="itemEditarPegar"/>
                </Menu>
                <Menu text="Ver"/>
                <Menu text="Ejecutar"/>
                <Menu text="Herramientas"/>
                <Menu text="Opciones">
                    <RadioMenuItem text="Modo Claro"
                                   fx:id="radioModoClaro"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Configurar API de CerberusAI..."
                              fx:id="itemConfigurarApiIA"/>
                </Menu>
                <Menu text="Ayuda"/>
            </MenuBar>

            <HBox alignment="CENTER_LEFT"
                  spacing="12"
                  styleClass="ide-toolbar">
                <padding>
                    <Insets top="10" right="16"
                            bottom="10" left="16"/>
                </padding>

                <Label text="◈" styleClass="ide-logo"/>
                <Label text="CERBERUS" styleClass="ide-brand"/>
                <Label text="IDE" styleClass="ide-brand-secondary"/>

                <Separator orientation="VERTICAL"
                           styleClass="toolbar-separator"/>

                <Label text="Proyecto:"
                       styleClass="toolbar-project"/>
                <Label fx:id="lblProyecto"
                       text="Sin proyecto"
                       styleClass="toolbar-project"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="● Sin errores recientes"
                       styleClass="ide-status"/>

                <Button text="▶  Compilar"
                        fx:id="btnCompilar"
                        styleClass="btn-compilar"/>
            </HBox>
        </VBox>
    </top>

    <!-- ÁREA PRINCIPAL DEL IDE -->
    <center>
        <SplitPane fx:id="splitPrincipal"
                   dividerPositions="0.19, 0.79"
                   styleClass="ide-split">

            <items>

                <!-- EXPLORADOR IZQUIERDO -->
                <VBox spacing="8" styleClass="explorer-panel">
                    <padding>
                        <Insets top="12" right="10"
                                bottom="10" left="10"/>
                    </padding>

                    <Label text="EXPLORADOR"
                           styleClass="panel-heading"/>

                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Button text="Abrir carpeta"
                                fx:id="btnAbrirProyecto"
                                styleClass="explorer-action"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="↻"
                                fx:id="btnRefrescarProyecto"
                                styleClass="icon-button"/>
                    </HBox>

                    <Label fx:id="lblProyectoVacio"
                           text="No hay ningún proyecto abierto. Usa «Abrir carpeta» para empezar."
                           wrapText="true"
                           styleClass="tree-item-muted"/>

                    <TreeView fx:id="treeProyecto"
                              visible="false"
                              managed="false"
                              VBox.vgrow="ALWAYS"
                              styleClass="project-tree"/>
                </VBox>

                <!-- EDITOR Y RESULTADOS -->
                <SplitPane orientation="VERTICAL"
                           dividerPositions="0.70"
                           styleClass="editor-split">

                    <items>

                        <!-- EDITOR -->
                        <VBox spacing="0" styleClass="editor-panel">

                            <TabPane fx:id="tabsEditor"
                                     VBox.vgrow="ALWAYS"
                                     tabClosingPolicy="ALL_TABS"
                                     styleClass="editor-tabs-pane"/>

                            <HBox alignment="CENTER_LEFT"
                                  spacing="14"
                                  styleClass="editor-status">
                                <padding>
                                    <Insets top="5" right="10"
                                            bottom="5" left="10"/>
                                </padding>
                                <Label text="CERBERUS"
                                       styleClass="status-item"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblPosicion"
                                       text="Línea 1, columna 1"
                                       styleClass="status-item"/>
                                <Label text="UTF-8"
                                       styleClass="status-item"/>
                                <Label text="Espacios: 4"
                                       styleClass="status-item"/>
                            </HBox>
                        </VBox>

                        <!-- PANEL INFERIOR -->
                        <VBox spacing="0" styleClass="output-panel">
                            <HBox alignment="CENTER_LEFT"
                                  styleClass="output-header">
                                <padding>
                                    <Insets top="8" right="12"
                                            bottom="8" left="12"/>
                                </padding>
                                <Label text="RESULTADOS"
                                       styleClass="panel-heading"/>
                            </HBox>

                            <TabPane fx:id="tabResultados"
                                     styleClass="pestanas"
                                     tabClosingPolicy="UNAVAILABLE"
                                     VBox.vgrow="ALWAYS">
                                <tabs>
                                    <Tab text="Léxico">
                                        <content>
                                            <TextArea fx:id="txtLexico"
                                                      editable="false"
                                                      wrapText="false"
                                                      styleClass="resultado"/>
                                        </content>
                                    </Tab>

                                    <Tab text="Sintáctico">
                                        <content>
                                            <TextArea fx:id="txtSintactico"
                                                      editable="false"
                                                      wrapText="false"
                                                      styleClass="resultado"/>
                                        </content>
                                    </Tab>

                                    <Tab text="Semántico">
                                        <content>
                                            <TextArea fx:id="txtSemantico"
                                                      editable="false"
                                                      wrapText="false"
                                                      styleClass="resultado"/>
                                        </content>
                                    </Tab>

                                    <Tab text="Documentador">
                                        <content>
                                            <TextArea fx:id="txtDocumentador"
                                                      editable="false"
                                                      wrapText="false"
                                                      styleClass="resultado"/>
                                        </content>
                                    </Tab>
                                </tabs>
                            </TabPane>
                        </VBox>

                    </items>
                </SplitPane>

                <!-- PANEL LATERAL DE CERBERUSAI -->
                <VBox spacing="0" styleClass="ai-panel">

                    <HBox alignment="CENTER_LEFT"
                          spacing="10"
                          styleClass="ai-header">
                        <padding>
                            <Insets top="12" right="12"
                                    bottom="12" left="12"/>
                        </padding>

                        <Label text="◈" styleClass="ai-logo"/>

                        <VBox spacing="2">
                            <Label text="CERBERUSai"
                                   styleClass="ai-title"/>
                            <Label text="Asistente de programación"
                                   styleClass="ai-subtitle"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <Separator/>

                    <fx:include source="chat_cerberus.fxml"
                                fx:id="chatCerberus"
                                VBox.vgrow="ALWAYS"/>

                </VBox>

            </items>
        </SplitPane>
    </center>

    <!-- BARRA DE ESTADO INFERIOR -->
    <bottom>
        <HBox alignment="CENTER_LEFT"
              spacing="12"
              styleClass="ide-bottom-bar">
            <padding>
                <Insets top="5" right="12"
                        bottom="5" left="12"/>
            </padding>

            <Label text="CERBERUS IDE"
                   styleClass="status-item"/>
            <Label text="● Listo"
                   styleClass="status-item"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Compilador"
                   styleClass="status-item"/>
            <Label text="CERBERUSai"
                   styleClass="status-item"/>
        </HBox>
    </bottom>

</BorderPane>
