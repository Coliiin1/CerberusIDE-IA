<?xml version="1.0" encoding="UTF-8"?>

<!--
  Componente autonomo del chat CerberusAI (Fase 6 de CERBERUSIA_IMPLEMENTATION.md).

  Integracion en 2 pasos (sin acoplar el resto de la UI):
    1) En tu FXML:      <fx:include source="chat_cerberus.fxml" fx:id="chatCerberus"/>
    2) En el controlador padre:
         @FXML private ChatCerberusController chatCerberusController;
         chatCerberusController.setInsertarHandler(codigo -> txtCodigo.setText(codigo));

  URL de la API: se configura fuera del chat (menu Opciones del IDE o variable de
  entorno CERBERUSAI_API_URL); no se muestra como campo editable en el panel.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/24" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.ChatCerberusController" styleClass="panel-chat" spacing="8">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Rol:" styleClass="etiqueta"/>
        <ComboBox fx:id="cmbRol"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblChatEstado" text="" styleClass="estado-chat"/>
    </HBox>
    <TextArea fx:id="txtChatPrompt" promptText="Describe el programa, el codigo a explicar o a corregir..."
              prefRowCount="4" wrapText="true" styleClass="resultado"/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button fx:id="btnEnviarChat" text="ENVIAR" styleClass="btn-compilar"/>
        <Button fx:id="btnInsertarEditor" text="INSERTAR EN EDITOR" styleClass="btn-insertar" disable="true"/>
    </HBox>
    <TextArea fx:id="txtChatRespuesta" editable="false" wrapText="true" VBox.vgrow="ALWAYS" styleClass="resultado"/>
</VBox>
